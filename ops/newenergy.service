# service host 上的系统级 unit。由 ops/deploy.sh 安装到
# /etc/systemd/system/newenergy.service
#
# 环境变量（含 TAVILY_API_KEY 等）不在 unit 里，放在
# /etc/newenergy-ai-article-platform/env，见 ops/README.md。
[Unit]
Description=New Energy AI Article Pipeline System
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=newenergy
Group=newenergy
WorkingDirectory=/opt/newenergy-ai-article-platform
EnvironmentFile=/etc/newenergy-ai-article-platform/env
# 监听端口；与 ops/deploy.sh 的 PORT 保持一致，改动要两处一起改。
Environment=PORT=18580
ExecStart=/usr/local/bin/node dist/server.cjs
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/newenergy-ai-article-platform/data

[Install]
WantedBy=multi-user.target
